{
  "$schema": "./schema.json",
  "enabled": true,
  "silent": false,
  "default": "general",
  "strategy": "subscription_balance",

  "categoryStrategies": {
    "quick": "subscription_balance",
    "general": "subscription_balance",
    "writing": "subscription_balance",
    "frontier": "subscription_balance"
  },

  "classifier": {
    "enabled": true,
    "model": "openai-codex/gpt-5.4-mini",
    "method": "auto",
    "fallbackToRegex": true
  },

  "cache": {
    "enabled": true,
    "maxEntries": 500,
    "threshold": 0.88
  },

  "reliability": {
    "enabled": true,
    "failureThreshold": 3,
    "windowMinutes": 5,
    "cooldownMinutes": 60
  },

  "debug": {
    "enabled": false
  },

  "models": {
    "quick": [],
    "general": [],
    "writing": [],
    "frontier": []
  }
}
